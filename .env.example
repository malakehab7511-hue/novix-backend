# ───── عام ─────
NODE_ENV=production
PORT=3000
# خلف Nginx/Railway/Render = 1 | تشغيل محلي مباشر = 0
TRUST_PROXY=1

# ───── قاعدة البيانات (MongoDB Atlas) ─────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/novix?retryWrites=true&w=majority
# القراءات القديمة بتتمسح بعد كام يوم (افتراضي 14)
# SENSOR_TTL_DAYS=14

# ───── تسجيل الدخول ─────
JWT_SECRET=ضعي_هنا_نص_عشوائي_طويل_64_حرف
JWT_EXPIRES_IN=7d

# ───── الإيميل ─────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ───── Google OAuth (اختياري) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───── رابط الفرونت (من غير / في الآخر). ممكن أكتر من رابط بفاصلة ─────
FRONTEND_URL=https://novix-dashboard.vercel.app

# ───── مفتاح الـ ESP32 (نفس القيمة في صفحة NOVIX-Setup) ─────
# لتوليد مفتاح:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=

# ───── الكاميرا ─────
VISION_API_KEY=
# الباك إند → vision-service (اللقطة الحية). فاضيين لو الـ vision-service مش على نفس الجهاز
VISION_SERVICE_URL=
VISION_SERVICE_KEY=
# SNAPSHOT_KEEP_DAYS=7
# SNAPSHOT_MAX_FILES=300

# ───── الـ AI service (اختياري — فاضي = قواعد ثابتة بدل الـ AI) ─────
AI_SERVICE_URL=
# AI_TIMEOUT_MS=2000

# ───── الـ Baseline ─────
# حطيها true مرة واحدة + restart لمسح الـ baseline والتعلم من جديد (وبعدين شيليها)
# BASELINE_RESET=false
# BASELINE_MAX_AGE_DAYS=30
